    <!-- Projects Section -->
    <section id="projects" class="py-24 bg-gray-100/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16 reveal">
                <h2 class="font-serif text-4xl md:text-5xl font-bold text-royal-dark mb-4">開源貢獻 & 技術資源</h2>
                <div class="w-24 h-1 bg-royal-red mx-auto"></div>
                <p class="mt-4 text-gray-600">Charles AI 核心技術的展示與社群連結。</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="reveal delay-100 p-8 bg-white border border-gray-200 shadow-md hover:shadow-xl transition-all duration-300 text-center">
                    <i class="fa-solid fa-robot text-4xl text-royal-red mb-4"></i>
                    <h3 class="font-serif text-2xl font-bold text-royal-dark mb-3">自動化會議記錄摘要機器人</h3>
                    <p class="text-gray-600 mb-6 text-sm">基於 Whisper 模型與 GPT-4，自動將錄音檔轉錄並生成條列式會議紀錄。</p>
                    <a href="https://lin.ee/JxZy1M7" target="_blank" class="px-6 py-2 border border-royal-red text-royal-red font-medium hover:bg-royal-red hover:text-white transition-all duration-300 inline-flex items-center gap-2">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Demo 連結
