            </div>
        </div>
    </section>

    <!-- ★★★ 修正後的「預約皇家諮詢」區塊 ★★★ -->
    <section id="contact" class="py-24 bg-royal-dark text-white relative overflow-hidden">
        <div class="absolute inset-0 opacity-10 pattern-dots"></div>
        <div class="max-w-4xl mx-auto px-4 relative z-10 text-center">
            <div class="reveal">
                <i class="fa-solid fa-envelope-open-text text-5xl text-royal-red mb-6"></i>
                <h2 class="font-serif text-4xl font-bold mb-4">預約皇家諮詢</h2>
                <p class="text-gray-400 mb-10">無論是環保議題或是下午茶禮儀，King Charles AI 隨時準備回應（如果秘書安排得進去的話）。</p>
            </div>
            <!-- 表單現在直接發送至 Formsubmit.co 的 ajax 端點 -->
            <form id="royal-consultation-form" class="reveal delay-100 max-w-lg mx-auto space-y-4 text-left" novalidate>
                <!-- 郵件主旨 -->
                <input type="hidden" name="_subject" value="【皇家諮詢】新訊息來自 HAIL KING CHARLES 網站">
                <!-- Formsubmit 蜜罐：防止垃圾郵件 -->
                <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">

                <div>
                    <label for="sender-name" class="block text-sm font-medium text-gray-400 mb-1">您的爵位 / Name</label>
                    <input type="text" id="sender-name" name="爵位／姓名" required class="w-full px-4 py-3 bg-white/10 border border-gray-700 rounded-none focus:border-royal-red focus:ring-1 focus:ring-royal-red outline-none text-white transition-all" placeholder="Sir / Madam...">
                </div>
                <div>
                    <label for="sender-topic" class="block text-sm font-medium text-gray-400 mb-1">諮詢議題 / Topic</label>
                    <select id="sender-topic" name="諮詢議題" class="w-full px-4 py-3 bg-white/10 border border-gray-700 rounded-none focus:border-royal-red focus:ring-1 focus:ring-royal-red outline-none text-white transition-all">
                        <option class="text-black" value="外商投資">外商投資 (Investment)</option>
                        <option class="text-black" value="環境保護">環境保護 (Environment)</option>
                        <option class="text-black" value="如何正確泡茶">如何正確泡茶 (Tea Etiquette)</option>
                    </select>
                </div>
                <div>
                    <label for="sender-message" class="block text-sm font-medium text-gray-400 mb-1">訊息內容 / Message</label>
                    <textarea id="sender-message" name="訊息內容" rows="4" required class="w-full px-4 py-3 bg-white/10 border border-gray-700 rounded-none focus:border-royal-red focus:ring-1 focus:ring-royal-red outline-none text-white transition-all" placeholder="God Save The King..."></textarea>
                </div>
                <button type="submit" id="submit-btn" class="w-full py-4 bg-royal-red text-white font-bold tracking-widest hover:bg-white hover:text-royal-red transition-all duration-300 uppercase">
                    發送請求
                </button>
                <div id="form-feedback" class="form-feedback"></div>
            </form>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-black py-8 border-t border-gray-800">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p class="text-gray-500 font-serif text-sm">
                &copy; 2024 The Royal Intelligence. Designed by Web Design Master. <br>
                <span class="text-xs text-gray-600">Not officially affiliated with the House of Windsor. Just a tribute to the AI Monarch.</span>
            </p>
        </div>
    </footer>

    <!-- Scripts -->
    <script>
        // ---- 1. 滾動顯示動畫 ----
        const observerOptions = { threshold: 0.1, rootMargin: "0px 0px -50px 0px" };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        // ---- 2. 手機選單切換 ----
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileBtn.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));

        // ---- 3. 背景粒子動畫 ----
        const canvas = document.getElementById('bg-canvas');
        const ctx = canvas.getContext('2d');
        let particlesArray;
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        window.addEventListener('resize', () => {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            init();
        });
        class Particle {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 3 + 1;
                this.speedX = (Math.random() * 1.5 - 0.75);
                this.speedY = (Math.random() * 1.5 - 0.75);
                const random = Math.random();
                if (random > 0.9) this.color = 'rgba(200, 16, 46, 0.4)';
                else this.color = 'rgba(200, 200, 200, 0.2)';
            }
            update() {
                this.x += this.speedX;
                this.y += this.speedY;
                if (this.x > canvas.width) this.x = 0;
                if (this.x < 0) this.x = canvas.width;
                if (this.y > canvas.height) this.y = 0;
                if (this.y < 0) this.y = canvas.height;
            }
            draw() {
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }
        function init() {
            particlesArray = [];
            let numberOfParticles = (canvas.height * canvas.width) / 9000;
            for (let i = 0; i < numberOfParticles; i++) particlesArray.push(new Particle());
        }
        function animate() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            for (let i = 0; i < particlesArray.length; i++) {
                particlesArray[i].update();
                particlesArray[i].draw();
            }
            requestAnimationFrame(animate);
        }
        init();
        animate();

        // ---- 4. 表單提交至 Email (使用 Formsubmit.co) ----
        const consultationForm = document.getElementById('royal-consultation-form');
        const submitBtn = document.getElementById('submit-btn');
        const feedbackEl = document.getElementById('form-feedback');

        // 直接設定為您的信箱，使用 Formsubmit 的 ajax 端點
        const FORM_ENDPOINT = "https://formsubmit.co/ajax/yyyyyungeric@yahoo.com.tw";

        function showFeedback(message, type) {
            feedbackEl.textContent = message;
            feedbackEl.className = 'form-feedback show ' + type;
            setTimeout(() => { feedbackEl.className = 'form-feedback'; }, 6000);
        }

        function setButtonLoading(isLoading) {
            if (isLoading) {
                submitBtn.classList.add('btn-submitting');
                submitBtn.textContent = '傳送中...';
                submitBtn.disabled = true;
            } else {
                submitBtn.classList.remove('btn-submitting');
                submitBtn.textContent = '發送請求';
                submitBtn.disabled = false;
            }
        }

        consultationForm.addEventListener('submit', async function(event) {
            event.preventDefault();

            // 簡易驗證
            const nameInput = document.getElementById('sender-name');
            const messageInput = document.getElementById('sender-message');
            if (!nameInput.value.trim()) {
                showFeedback('請填寫您的爵位或姓名。', 'error');
                nameInput.focus();
                return;
            }
            if (!messageInput.value.trim()) {
                showFeedback('請填寫訊息內容。', 'error');
                messageInput.focus();
                return;
            }

            // 準備資料 (使用 JSON 格式)
            const formData = {
                name: nameInput.value.trim(),          // 顯示在郵件中的姓名
                topic: document.getElementById('sender-topic').value,
                message: messageInput.value.trim(),
                _subject: '【皇家諮詢】新訊息來自 HAIL KING CHARLES 網站',
            };

            setButtonLoading(true);
            feedbackEl.className = 'form-feedback'; // 清除舊訊息

            try {
                const response = await fetch(FORM_ENDPOINT, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });

                if (response.ok) {
                    showFeedback('✅ 您的請求已成功發送至白金漢宮伺服器！\n（首次使用 Formsubmit 可能需要收件人確認郵件）', 'success');
                    consultationForm.reset();
                } else {
                    const errorData = await response.json().catch(() => ({}));
                    console.error('提交錯誤：', errorData);
                    showFeedback('❌ 傳送失敗，請稍後再試。若持續發生，請直接寄信至 yyyyyungeric@yahoo.com.tw。', 'error');
                }
            } catch (networkError) {
                console.error('網路錯誤：', networkError);
                showFeedback('❌ 網路連線異常，請檢查您的網路後再試。', 'error');
            } finally {
                setButtonLoading(false);
            }
        });
    </script>
</body>
</html>
