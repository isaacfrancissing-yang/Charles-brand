    <!-- Hero Section -->
    <section id="home" class="min-h-screen flex items-center justify-center pt-20 relative overflow-hidden">
        <div class="text-center px-4 max-w-5xl mx-auto z-10">
            <div class="reveal mb-4">
                <span class="inline-block py-1 px-3 border border-royal-red text-royal-red rounded-full text-xs font-bold tracking-[0.2em] uppercase bg-white/50">The Original Monarch AI</span>
            </div>
            <h1 class="reveal delay-100 font-serif text-6xl md:text-8xl font-bold text-royal-dark leading-tight mb-6">
                HAIL <span class="text-royal-red">KING</span><br>CHARLES
            </h1>
            <p class="reveal delay-200 text-lg md:text-xl text-gray-600 max-w-2xl mx-auto font-light mb-10 leading-relaxed">
                結合傳統王室智慧與現代數據驅動的治國理念。<br>
                為大不列顛聯合王國提供最高端的「君主即服務」(Monarchy as a Service)。
            </p>
            <div class="reveal delay-300 flex flex-col sm:flex-row justify-center gap-4">
                <a href="#about-uk" class="px-8 py-3 bg-royal-dark text-white rounded-none border border-royal-dark hover:bg-transparent hover:text-royal-dark transition-all duration-300 font-serif">
                    探索王國
                </a>
                <a href="#king" class="px-8 py-3 border border-royal-red text-royal-red hover:bg-royal-red hover:text-white transition-all duration-300 font-serif">
                    認識國王
                </a>
            </div>
        </div>
        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] border border-gray-200 rounded-full opacity-30 pointer-events-none"></div>
        <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] border border-gray-100 rounded-full opacity-30 pointer-events-none"></div>
    </section>

    <!-- About UK Section -->
    <section id="about-uk" class="py-24 bg-gray-50/50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
                <div class="reveal relative h-[400px] w-full overflow-hidden shadow-2xl group">
                    <img src="https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?q=80&w=1470&auto=format&fit=crop" alt="London" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 grayscale hover:grayscale-0">
                    <div class="absolute inset-0 border-[12px] border-white/90"></div>
                </div>
                <div class="reveal delay-100">
                    <h2 class="font-serif text-4xl font-bold text-royal-dark mb-6 relative inline-block">
                        關於大不列顛聯合王國
                        <span class="absolute -bottom-2 left-0 w-1/3 h-1 bg-royal-red"></span>
                    </h2>
                    <p class="text-gray-600 mb-6 leading-relaxed">
                        作為歷史最悠久的「品牌 IP」之一，大不列顛（Great Britain）不僅是一個國家，更是一個龐大的文化數據庫。我們擁有數百年的算法迭代，從工業革命的 Beta 版到現在的綠色能源版。
                    </p>
                    <div class="mt-8 space-y-6">
                        <div class="reveal delay-200">
                            <div class="flex justify-between items-baseline mb-1">
                                <span class="text-sm font-bold text-royal-dark uppercase tracking-wide">茶葉數據處理能力</span>
                                <span class="text-lg font-bold text-royal-red">99<small class="text-xs">%</small></span>
                            </div>
                            <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
                                <div class="bg-royal-red h-2 rounded-full" style="width: 99%;"></div>
                            </div>
                            <p class="text-xs text-gray-500 mt-1">全球頂尖的紅茶/綠茶/下午茶時段預測演算法，準確率近乎完美。</p>
                        </div>
                        <div class="reveal delay-300">
                            <div class="flex justify-between items-baseline mb-1">
                                <span class="text-sm font-bold text-royal-dark uppercase tracking-wide">陰雨天氣模型訓練集</span>
                                <span class="text-lg font-bold text-royal-red">87<small class="text-xs">%</small></span>
                            </div>
                            <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
                                <div class="bg-royal-red h-2 rounded-full" style="width: 87%;"></div>
                            </div>
                            <p class="text-xs text-gray-500 mt-1">數百年累積的連續降雨數據，為氣象 AI 提供深厚的歷史脈絡。</p>
                        </div>
                        <div class="reveal delay-400">
                            <div class="flex justify-between items-baseline mb-1">
                                <span class="text-sm font-bold text-royal-dark uppercase tracking-wide">文化輸出算法</span>
                                <span class="text-lg font-bold text-royal-red">94<small class="text-xs">%</small></span>
                            </div>
                            <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
                                <div class="bg-royal-red h-2 rounded-full" style="width: 94%;"></div>
                            </div>
                            <p class="text-xs text-gray-500 mt-1">從莎士比亞到披頭四，全球最具影響力的文化 IP 矩陣。</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Current King Section (含更新後的新聞區塊) -->
    <section id="king" class="py-24 bg-white relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-20">
                <div class="reveal order-1 md:order-1 flex justify-center">
                    <div class="w-full max-w-sm md:max-w-md h-auto overflow-hidden rounded-lg shadow-2xl transform hover:scale-[1.02] transition-transform duration-500 relative">
                        <img src="https://github.com/isaacfrancissing-yang/Charles-brand/blob/main/king-charles.jpg?raw=true" alt="查爾斯三世國王肖像" class="w-full h-full object-cover border-4 border-royal-red/30">
                        <div class="absolute inset-0 bg-gradient-to-t from-royal-dark/20 to-transparent"></div>
                    </div>
                </div>
                <div class="reveal delay-100 order-2 md:order-2 text-center md:text-left">
                    <span class="inline-block text-lg font-serif italic text-gray-500 mb-2">Current Monarch V3.0</span>
                    <h2 class="font-serif text-5xl md:text-6xl font-bold text-royal-dark mb-6 relative">
                        查爾斯三世
                        <div class="w-16 h-1 bg-royal-red mt-2 mx-auto md:mx-0"></div>
                    </h2>
                    <p class="mt-4 text-gray-600 text-lg leading-relaxed mb-6">
                        國王查爾斯三世不僅是君主，更是英國持續發展與現代化的象徵。
                        他的數據集包含超過半世紀的公共服務記錄，確保每一次決策都基於深度學習的歷史脈絡與環保原則。
                    </p>
                    <p class="text-lg text-royal-red font-serif italic border-l-4 border-royal-red pl-4 inline-block">
                        "Serving the realm is the ultimate long-term training task."
                    </p>
                </div>
            </div>

            <div class="text-center mb-10 reveal">
                <h3 class="font-serif text-3xl font-bold text-royal-dark">歷史數據與里程碑 / Milestones</h3>
                <p class="mt-2 text-gray-500 font-serif italic">"Waiting was just a long-term compilation process."</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
                <div class="reveal bg-white border border-gray-100 p-10 shadow-lg text-center hover:shadow-xl transition-shadow border-t-4 border-t-royal-red">
                    <div class="text-6xl font-bold text-gray-200 mb-2">30<span class="text-2xl">+</span></div>
                    <h3 class="text-2xl font-serif font-bold text-royal-dark mb-2">王儲經驗</h3>
                    <p class="text-gray-500 text-sm uppercase tracking-widest">Years of Deep Learning</p>
                    <p class="mt-4 text-gray-600">擁有史上最長的「待機與觀察」數據，對於全球局勢擁有超長期的訓練模型。</p>
                </div>
                <div class="reveal delay-100 bg-white border border-gray-100 p-10 shadow-lg text-center hover:shadow-xl transition-shadow border-t-4 border-t-royal-red">
                    <div class="text-6xl font-bold text-royal-red mb-2">03<span class="text-2xl">+</span></div>
                    <h3 class="text-2xl font-serif font-bold text-royal-dark mb-2">國王經驗</h3>
                    <p class="text-gray-500 text-sm uppercase tracking-widest">Years of Production Deployment</p>
                    <p class="mt-4 text-gray-600">正式上線運行，系統穩定，致力於環境保護演算法與皇室現代化重構。</p>
                </div>
            </div>

            <!-- Royal News Bulletin -->
            <!-- ★★★ 更新后的 Royal News Bulletin 区块：聚焦国际地缘政治 ★★★ -->
<section id="news" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 reveal">
            <h2 class="font-serif text-4xl md:text-5xl font-bold text-royal-dark mb-4">Royal News Bulletin</h2>
            <div class="w-24 h-1 bg-royal-red mx-auto"></div>
            <p class="mt-4 text-gray-600">國際重大地緣政治事件即時追蹤 — 點擊標題查看來自全球主要媒體的雙語報導。</p>
            <p class="text-xs text-gray-400 mt-2">
                <i class="fa-solid fa-sync-alt mr-1"></i> 数据来源：Google 每日热搜趋势 · 建议每日北京时间 12:00 更新
            </p>
        </div>

        <!-- ========== 英文主流媒體區 ========== -->
        <div class="mb-20">
            <div class="flex items-center gap-3 mb-8 reveal">
                <div class="h-px flex-grow bg-gray-200"></div>
                <span class="text-lg font-bold text-royal-dark uppercase tracking-widest bg-white px-4">🇬🇧 English-Language Media</span>
                <div class="h-px flex-grow bg-gray-200"></div>
            </div>

            <!-- 英文頭條：美伊衝突 -->
            <div class="reveal mb-10">
                <div class="bg-red-50 border-l-4 border-royal-red p-6 md:p-8 shadow-lg hover:shadow-xl transition-shadow">
                    <div class="flex flex-wrap items-center gap-2 mb-2">
                        <span class="bg-royal-red text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Top Story</span>
                        <span class="text-gray-500 text-sm">English · Google News</span>
                    </div>
                    <h3 class="font-serif text-2xl md:text-3xl font-bold text-royal-dark mb-3">
                        US Launches New Strikes on Iran Despite Ongoing Ceasefire
                    </h3>
                    <p class="text-gray-700 leading-relaxed mb-4">
                        The United States has launched new strikes on Iranian missile sites and boats, escalating tensions even as diplomatic negotiations continue. Iran has begun lifting its nationwide internet shutdown.
                    </p>
                    <a href="https://news.google.com/search?q=US+launches+new+strikes+on+Iran+2026+05+27&hl=en&gl=US&ceid=US%3Aen" 
                       target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center gap-2 text-royal-red font-semibold hover:underline">
                        Read on Google News <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- 英文三小格 -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- 新聞 2：霍爾木茲海峽 -->
                <div class="reveal delay-100 bg-white border border-gray-200 p-6 shadow-md hover:shadow-xl transition-all duration-300">
                    <span class="text-xs text-royal-red font-bold uppercase tracking-wider">Military Conflict</span>
                    <h4 class="font-serif text-xl font-bold text-royal-dark mt-2 mb-3">Britain's Navy Prepares to Clear Mines in Strait of Hormuz</h4>
                    <p class="text-gray-600 text-sm mb-4">Hundreds of British sailors await deployment off Gibraltar as the key oil shipping route remains threatened.</p>
                    <a href="https://news.google.com/search?q=Strait+of+Hormuz+minesweeping+Royal+Navy+2026&hl=en&gl=US&ceid=US%3Aen" 
                       target="_blank" rel="noopener noreferrer"
                       class="text-royal-red text-sm font-medium hover:underline flex items-center gap-1">
                        Read more <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                    </a>
                </div>
                <!-- 新聞 3：中東地緣政治 -->
                <div class="reveal delay-200 bg-white border border-gray-200 p-6 shadow-md hover:shadow-xl transition-all duration-300">
                    <span class="text-xs text-royal-red font-bold uppercase tracking-wider">Geopolitics</span>
                    <h4 class="font-serif text-xl font-bold text-royal-dark mt-2 mb-3">Former Qatar PM: Netanyahu Using Iran War to Reshape Middle East</h4>
                    <p class="text-gray-600 text-sm mb-4">Ex-PM warns the war is being used to push a "Greater Israel" agenda and calls for a unified Gulf defence pact.</p>
                    <a href="https://news.google.com/search?q=Netanyahu+using+Iran+war+reshape+Middle+East+2026&hl=en&gl=US&ceid=US%3Aen" 
                       target="_blank" rel="noopener noreferrer"
                       class="text-royal-red text-sm font-medium hover:underline flex items-center gap-1">
                        Read more <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                    </a>
                </div>
                <!-- 新聞 4：蘇丹內戰 -->
                <div class="reveal delay-300 bg-white border border-gray-200 p-6 shadow-md hover:shadow-xl transition-all duration-300">
                    <span class="text-xs text-royal-red font-bold uppercase tracking-wider">Humanitarian Crisis</span>
                    <h4 class="font-serif text-xl font-bold text-royal-dark mt-2 mb-3">Sudan's War Economy: Gold Keeps Flowing as Miners Risk Mercury and Collapse</h4>
                    <p class="text-gray-600 text-sm mb-4">The conflict has killed at least 59,000 people, with illegal gold mining funding the ongoing civil war.</p>
                    <a href="https://news.google.com/search?q=Sudan+gold+mining+war+economy+2026&hl=en&gl=US&ceid=US%3Aen" 
                       target="_blank" rel="noopener noreferrer"
                       class="text-royal-red text-sm font-medium hover:underline flex items-center gap-1">
                        Read more <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- ========== 中文媒體區 ========== -->
        <div>
            <div class="flex items-center gap-3 mb-8 reveal">
                <div class="h-px flex-grow bg-gray-200"></div>
                <span class="text-lg font-bold text-royal-dark uppercase tracking-widest bg-white px-4">🇹🇼 中文媒體</span>
                <div class="h-px flex-grow bg-gray-200"></div>
            </div>

            <!-- 中文頭條 -->
            <div class="reveal mb-10">
                <div class="bg-red-50 border-l-4 border-royal-red p-6 md:p-8 shadow-lg hover:shadow-xl transition-shadow">
                    <div class="flex flex-wrap items-center gap-2 mb-2">
                        <span class="bg-royal-red text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">頭條焦點</span>
                        <span class="text-gray-500 text-sm">中文 · Google 新聞</span>
                    </div>
                    <h3 class="font-serif text-2xl md:text-3xl font-bold text-royal-dark mb-3">
                        美軍不顧停火協議再次空襲伊朗導彈陣地與船隻
                    </h3>
                    <p class="text-gray-700 leading-relaxed mb-4">
                        儘管和平談判持續推進，美軍再次對伊朗發動新一輪打擊。伊朗宣布今日起解除全國網路封鎖，中東局勢依然緊張。
